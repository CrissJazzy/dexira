---
import type { Article } from '../data/articles';
import { formatDate } from '../data/articles';

interface Props {
  article: Article;
  variant?: 'default' | 'pick';
}
const { article, variant = 'default' } = Astro.props;
const href = `/articles/${article.slug}/`;
---

<article class:list={['card', `card--${variant}`]}>
  <div class="media">
    <img
      src={article.image}
      alt={article.imageAlt}
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="body">
    <a class="cat eyebrow" href={`/category/${article.categorySlug}/`}>{article.category}</a>
    <h3 class="title"><a class="stretch" href={href}>{article.title}</a></h3>
    <p class="excerpt">{article.excerpt}</p>
    <p class="meta">
      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{article.readingTime} min read</span>
    </p>
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .media { overflow: hidden; background: var(--c-surface); }
  .media img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 400ms ease; }
  .card:hover .media img { transform: scale(1.02); }
  .body { display: flex; flex-direction: column; gap: var(--s-2); }
  .cat { position: relative; z-index: 1; align-self: flex-start; }
  .cat:hover { text-decoration: underline; }
  .title { font-size: var(--t-lg); color: var(--c-navy); }
  .stretch::after { content: ''; position: absolute; inset: 0; }
  .card:hover .title a { color: var(--c-accent); }
  .excerpt {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { display: flex; gap: var(--s-2); font-size: var(--t-xs); color: var(--c-muted); }

  /* Editor's Picks variant: taller crop, larger serif headline, ruled rather than boxed */
  .card--pick .media img { aspect-ratio: 4 / 3; }
  .card--pick .title { font-size: var(--t-xl); }
  .card--pick .excerpt { -webkit-line-clamp: 4; line-clamp: 4; }
</style>
