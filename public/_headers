# Netlify custom headers. Astro copies this file from public/ into dist/ at build time.
# Rules are applied in order; for a path that matches more than one rule, the later
# (more specific) rule is the one that should win for the same header.

# All pages and files
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# Astro's fingerprinted build output (CSS, JS, fonts). File names change when content
# changes, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
