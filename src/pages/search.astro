---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/site';
import { getAllArticles } from '../data/articles';
import { buildSearchText } from '../lib/search';

// Every article is rendered once (newest first, same source as the rest of the site).
// The script below only shows or hides cards, so the page works on a static host.
const articles = await getAllArticles();
const items = articles.map((article) => ({ article, text: buildSearchText(article) }));
const total = items.length;
// Robots: query-specific results should not be indexed, but links may be followed.
// (SEO.astro can only emit "noindex, nofollow", so the tag is added through the head slot.)
---

<Layout
  title="Search"
  description="Search DEXIRA stories by keyword, topic, category or author."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="container page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Search' }]} />

    <header class="intro">
      <h1 class="name">Search DEXIRA</h1>
      <p class="lead">Find stories by title, topic, category or author.</p>

      <form id="search-form" class="form" role="search" method="get" action="/search/">
        <label class="label" for="q">Search stories</label>
        <div class="row">
          <input
            id="q"
            name="q"
            type="search"
            class="input"
            maxlength="100"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="For example: cybersecurity"
          />
          <button type="submit" class="btn">Search</button>
        </div>
      </form>
      <p class="clear-wrap"><a id="clear" class="clear" href="/search/" hidden>Clear search</a></p>
    </header>

    <noscript>
      <p class="notice">JavaScript is needed to filter results. All stories are listed below.</p>
    </noscript>

    <section class="results" aria-labelledby="results-title">
      <h2 id="results-title" class="section-title">All stories</h2>
      <p id="search-status" class="status" role="status" aria-live="polite">
        {total} {total === 1 ? 'story' : 'stories'}
      </p>

      <ul id="results" class="grid" role="list">
        {items.map(({ article, text }) => (
          <li data-search={text}>
            <ArticleCard article={article} />
          </li>
        ))}
      </ul>

      <div id="no-results" class="empty" hidden>
        <h3 class="empty-title">No stories match your search</h3>
        <p class="empty-text">
          Try a different word, check the spelling, or use fewer words. You can also browse by category.
        </p>
        <ul class="pills" role="list">
          {categories.map((c) => (
            <li><a class="pill" href={`/category/${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { parseQuery, tokenize, matchesAll, describeResults } from '../lib/search';

  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('q') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const heading = document.getElementById('results-title');
  const clear = document.getElementById('clear');
  const empty = document.getElementById('no-results');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#results > li[data-search]'));

  function run() {
    if (!form || !input || !status || !heading || !clear || !empty) return;
    const query = parseQuery(window.location.search);
    const tokens = tokenize(query);
    let visible = 0;
    for (const el of items) {
      const show = tokens.length === 0 || matchesAll(el.dataset.search ?? '', tokens);
      el.hidden = !show;
      if (show) visible += 1;
    }
    // Only textContent / .value are used: user input is never parsed as HTML.
    input.value = query;
    status.textContent = describeResults(visible, query, items.length);
    heading.textContent = tokens.length === 0 ? 'All stories' : 'Results';
    clear.hidden = query === '';
    empty.hidden = !(tokens.length > 0 && visible === 0);
  }

  form?.addEventListener('submit', (event) => {
    if (!input) return;
    event.preventDefault();
    const q = input.value.replace(/\s+/g, ' ').trim();
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    const qs = params.toString();
    history.pushState({}, '', window.location.pathname + (qs ? `?${qs}` : ''));
    run();
  });

  window.addEventListener('popstate', run);
  run();
</script>

<style>
  .page { padding-top: var(--s-6); padding-bottom: var(--s-12); }
  .intro { margin-top: var(--s-8); max-width: 40rem; }
  .name { font-size: var(--t-3xl); color: var(--c-navy); }
  .lead { margin-top: var(--s-4); font-size: var(--t-lg); color: var(--c-ink-soft); }

  .form { margin-top: var(--s-8); }
  .label { display: block; margin-bottom: var(--s-2); font-size: var(--t-sm); font-weight: 600; color: var(--c-navy); }
  .row { display: flex; gap: var(--s-3); }
  .input {
    flex: 1;
    min-width: 0;
    padding: var(--s-3) var(--s-4);
    font: inherit;
    color: var(--c-ink);
    background: var(--c-bg);
    border: 1px solid var(--c-muted);
    border-radius: var(--radius);
  }
  .input:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; border-color: var(--c-accent); }
  .btn {
    padding: var(--s-3) var(--s-6);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 600;
    color: #fff;
    background: var(--c-accent);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--ease);
  }
  .btn:hover { background: var(--c-accent-dark); }
  .clear-wrap { margin-top: var(--s-3); min-height: 1.5rem; }
  .clear { font-size: var(--t-sm); font-weight: 600; color: var(--c-accent); text-decoration: underline; text-underline-offset: 2px; }
  .clear:hover { color: var(--c-accent-dark); }
  .clear[hidden] { display: none; }

  .notice { margin-top: var(--s-6); font-size: var(--t-sm); color: var(--c-muted); }

  .results { margin-top: var(--s-12); }
  .section-title { font-size: var(--t-xl); color: var(--c-navy); }
  .status { margin-top: var(--s-2); margin-bottom: var(--s-6); font-size: var(--t-sm); font-weight: 600; color: var(--c-muted); overflow-wrap: anywhere; }

  .grid { display: grid; gap: var(--s-8); grid-template-columns: minmax(0, 1fr); }
  .grid > li { min-width: 0; }
  .grid > li[hidden] { display: none; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .empty {
    padding: var(--s-12) var(--gutter);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    text-align: center;
  }
  .empty[hidden] { display: none; }
  .empty-title { font-size: var(--t-xl); color: var(--c-navy); }
  .empty-text { max-width: 34rem; margin: var(--s-3) auto var(--s-6); color: var(--c-ink-soft); }
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); }
  .pill {
    display: inline-block;
    padding: var(--s-2) var(--s-4);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--c-ink-soft);
    transition: border-color var(--ease), color var(--ease);
  }
  .pill:hover { border-color: var(--c-accent); color: var(--c-accent); }

  @media (max-width: 479px) {
    .row { flex-direction: column; }
    .btn { padding-block: var(--s-3); }
  }
</style>
