---
import type { Article } from '../data/articles';
import SectionHeader from './SectionHeader.astro';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="related container" aria-labelledby="related-title">
    <SectionHeader id="related-title" title="Related Stories" />
    <div class="grid">
      {articles.map((a) => <ArticleCard article={a} />)}
    </div>
  </section>
)}

<style>
  .related { padding-block: var(--s-12) 0; }
  .grid { display: grid; gap: var(--s-8); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
