---
// No backend exists yet. The form stays disabled until PUBLIC_NEWSLETTER_ACTION is set
// to a real provider's form-post URL (a public value, not a secret). Nothing is faked.
const action = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
const connected = Boolean(action);
---

<section class="newsletter container" aria-labelledby="newsletter-title">
  <div class="panel">
    <div class="copy">
      <p class="eyebrow">Newsletter</p>
      <h2 id="newsletter-title">Stay curious. Stay informed.</h2>
      <p>
        Get thoughtful perspectives, important discoveries and stories worth your attention,
        delivered to your inbox.
      </p>
    </div>

    <form class="form" method="post" action={action}>
      <fieldset disabled={!connected}>
        <legend class="sr-only">Subscribe to the DEXIRA newsletter</legend>
        <label for="newsletter-email">Email address</label>
        <div class="row">
          <input
            id="newsletter-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
          <button type="submit">Subscribe</button>
        </div>
      </fieldset>
      <p class="privacy">Your email address will only be used to send the DEXIRA newsletter.</p>
      {!connected && (
        <p class="status" role="note">
          Newsletter signup isn’t connected yet. This form will be activated once an email service is set up.
        </p>
      )}
    </form>
  </div>
</section>

<style>
  .newsletter { padding-block: var(--s-12) 0; }
  .panel {
    display: grid;
    gap: var(--s-8);
    padding: var(--s-8) var(--s-6);
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--c-accent);
  }
  h2 { font-size: var(--t-2xl); color: var(--c-navy); margin-block: var(--s-2) var(--s-3); }
  .copy p:last-child { color: var(--c-ink-soft); max-width: 46ch; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  label { display: block; font-size: var(--t-sm); font-weight: 600; margin-bottom: var(--s-2); }
  .row { display: flex; flex-direction: column; gap: var(--s-3); }
  input {
    width: 100%;
    font: inherit;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--c-muted);
    border-radius: var(--radius);
    background: #fff;
    color: var(--c-ink);
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: var(--s-3) var(--s-6);
    border: 0;
    border-radius: var(--radius);
    background: var(--c-navy);
    color: #fff;
    cursor: pointer;
    transition: background var(--ease);
  }
  button:hover { background: var(--c-accent-dark); }
  fieldset:disabled input { background: var(--c-surface); border-color: var(--c-line); }
  fieldset:disabled button { background: var(--c-muted); cursor: not-allowed; }
  .privacy { margin-top: var(--s-3); font-size: var(--t-xs); color: var(--c-muted); }
  .status { margin-top: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-soft); font-style: italic; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  @media (min-width: 900px) {
    .panel { grid-template-columns: 1.2fr 1fr; gap: var(--s-12); padding: var(--s-12); align-items: center; }
    .row { flex-direction: row; }
    input { flex: 1; }
  }
</style>
