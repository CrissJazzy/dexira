---
import type { Article } from '../data/articles';
import { formatDate } from '../data/articles';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const href = `/articles/${article.slug}/`;
---

<article class="feature">
  <div class="media">
    <img
      src={article.image}
      alt={article.imageAlt}
      width="1600"
      height="1000"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="body">
    <p class="eyebrow">Featured story</p>
    <h2 class="title"><a class="stretch" href={href}>{article.title}</a></h2>
    <p class="excerpt">{article.excerpt}</p>
    <p class="meta">
      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{article.readingTime} min read</span>
    </p>
  </div>
</article>

<style>
  .feature { position: relative; display: grid; gap: var(--s-6); min-width: 0; }
  .media { overflow: hidden; background: var(--c-surface); }
  .media img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .body { display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }
  .title { font-size: var(--t-2xl); color: var(--c-navy); overflow-wrap: anywhere; }
  .stretch::after { content: ''; position: absolute; inset: 0; }
  .feature:hover .title a { color: var(--c-accent); }
  .excerpt { font-size: var(--t-base); color: var(--c-ink-soft); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--s-2); font-size: var(--t-xs); color: var(--c-muted); }

  @media (min-width: 900px) {
    .feature { grid-template-columns: 1.15fr 1fr; gap: var(--s-12); align-items: center; }
  }
</style>
