---
import Breadcrumbs from './Breadcrumbs.astro';
import { formatDate } from '../data/articles';

interface Props {
  title: string;
  intro: string;
  /** ISO date (YYYY-MM-DD) of the last substantive update. */
  updated: string;
}
const { title, intro, updated } = Astro.props;
---

<div class="container page">
  <div class="measure">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
    <header class="head">
      <h1 class="title">{title}</h1>
      <p class="lead">{intro}</p>
      <p class="updated">Last updated <time datetime={updated}>{formatDate(updated)}</time></p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</div>

<style>
  .page { padding-top: var(--s-6); padding-bottom: var(--s-12); }
  .measure { max-width: 46rem; margin-inline: auto; }
  .head { margin-top: var(--s-8); padding-bottom: var(--s-6); border-bottom: 1px solid var(--c-line); }
  .title { font-size: var(--t-3xl); color: var(--c-navy); overflow-wrap: anywhere; }
  .lead { margin-top: var(--s-4); font-size: var(--t-lg); color: var(--c-ink-soft); }
  .updated { margin-top: var(--s-3); font-size: var(--t-sm); color: var(--c-muted); }

  .prose :global(h2) { margin-top: var(--s-12); font-size: var(--t-xl); color: var(--c-navy); }
  .prose :global(h2:first-child) { margin-top: var(--s-8); }
  .prose :global(p) { margin-top: var(--s-4); color: var(--c-ink-soft); line-height: 1.75; }
  .prose :global(ul) { margin-top: var(--s-4); padding-left: var(--s-6); list-style: disc; color: var(--c-ink-soft); line-height: 1.75; }
  .prose :global(li + li) { margin-top: var(--s-2); }
  .prose :global(a) { color: var(--c-accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(a:hover) { color: var(--c-accent-dark); }
  .prose :global(strong) { color: var(--c-ink); }
</style>
