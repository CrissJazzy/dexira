---
import Layout from '../layouts/Layout.astro';
import EditorialIntro from '../components/EditorialIntro.astro';
import FeaturedStory from '../components/FeaturedStory.astro';
import TrendingStories from '../components/TrendingStories.astro';
import LatestStories from '../components/LatestStories.astro';
import CategoryExplorer from '../components/CategoryExplorer.astro';
import EditorsPicks from '../components/EditorsPicks.astro';
import Newsletter from '../components/Newsletter.astro';
import {
  getAllArticles,
  getFeaturedArticle,
  getTrendingArticles,
  getLatestArticles,
  getEditorPicks,
} from '../data/articles';

const allArticles = await getAllArticles();
const hasArticles = allArticles.length > 0;
const [featured, trending, latest, picks] = await Promise.all([
  getFeaturedArticle(),
  getTrendingArticles(3),
  getLatestArticles(6),
  getEditorPicks(3),
]);
---

<Layout
  description="DEXIRA is an independent digital publication exploring the ideas, innovations and discoveries shaping our world."
  noindex={!hasArticles}
>
  <EditorialIntro />
  {!hasArticles && (
    <section class="empty container" aria-labelledby="empty-title">
      <h2 id="empty-title">Our first stories are on the way</h2>
      <p>DEXIRA is preparing its first collection of stories. Please check back soon.</p>
    </section>
  )}
  {featured && <FeaturedStory article={featured} />}
  {trending.length > 0 && <TrendingStories articles={trending} />}
  {latest.length > 0 && <LatestStories articles={latest} />}
  <CategoryExplorer />
  {picks.length > 0 && <EditorsPicks articles={picks} />}
  <Newsletter />
</Layout>

<style>
  .empty {
    margin-top: var(--s-6);
    margin-bottom: var(--s-12);
    padding: var(--s-12) var(--gutter);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    text-align: center;
  }
  .empty h2 { font-size: var(--t-xl); color: var(--c-navy); }
  .empty p { max-width: 34rem; margin: var(--s-3) auto 0; color: var(--c-ink-soft); }
</style>
